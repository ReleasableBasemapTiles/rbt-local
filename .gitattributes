# This stack's config files must always check out with Unix (LF) line
# endings, regardless of the cloning machine's git config (e.g. Windows'
# common core.autocrlf=true) -- a uwsgi.ini saved with Windows (CRLF) line
# endings prevents uWSGI from starting (see "A note on Git line endings" in
# docs/install-windows.md, and deploy.ps1's -Prep step, which repairs clones
# made before this file existed).
* text=auto

*.ini       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.conf      text eol=lf
*.json      text eol=lf
*.sh        text eol=lf
Dockerfile* text eol=lf
# micromamba reads these line by line, and a trailing CR would end up in each
# package URL and its checksum (see mapproxy/conda-*.lock).
*.lock      text eol=lf
# Copied to .env, and a shell script git runs as a hook.
.env.example text eol=lf
.githooks/* text eol=lf

*.png     binary
*.pbf     binary
*.mbtiles binary
