# Copy this file to .env and uncomment/edit any values you want to override.
# docker-compose.yaml and docker-compose.override.yaml read these via
# ${VAR:-default} substitution, so nothing here is required -- the defaults
# below match what the compose files use when a variable isn't set.
#
# deploy.sh and deploy.ps1 also load this file (if present), so you can set
# their optional S3_BUCKET_* variables below here once instead of exporting
# them in every shell. For those scripts (and for
# Compose run directly) a value already set in your environment takes
# precedence over the same key here -- except that on Linux deploy.sh runs
# Compose through sudo, which drops your shell's variables, so put Compose
# settings (ports, BIND_ADDR, worker counts) here rather than exporting them.

# Leave the S3_BUCKET_* variables unset to download the MBTiles anonymously
# from the public RBT mirror (see PUBLIC_S3_* in deploy.sh) -- no AWS
# credentials needed. Set one to download that file from your own bucket
# instead, with your own AWS credentials. Not read by Compose.
#
# Bucket (optionally with a prefix) containing RBT.mbtiles/TERRAIN.mbtiles,
# e.g. "my-bucket" or "s3://my-bucket/exports".
#S3_BUCKET_RBT=
#S3_BUCKET_TERRAIN=

# Bucket (optionally with a prefix) containing the EPSG:4087 RBT.mbtiles/
# TERRAIN.mbtiles -- only used by deploy.sh --4087 / deploy.ps1 -Use4087's
# download step (see docs/deployment-4087.md).
#S3_BUCKET_RBT_4087=
#S3_BUCKET_TERRAIN_4087=

# AWS CLI profile the download step's `aws s3` calls use for any
# S3_BUCKET_* you set above (the public mirror needs none). The README's
# "Using your own S3 bucket" step stores the credentials in a profile named
# "rbt", so set this unless you put them in your default profile instead.
# Not read by Compose.
#AWS_PROFILE=rbt

# Network interface the published ports bind to. The default (0.0.0.0)
# exposes RBT to every network interface, which may prompt a Windows
# Defender Firewall dialog on first `docker compose up -d`. Set this to
# 127.0.0.1 if you only need RBT on this machine.
#BIND_ADDR=0.0.0.0

# Ports each service publishes on the host (see docs/gis-clients.md
# "Available Service Endpoints" for what's reachable on each one).
#NGINX_PORT=8082
#MAPPROXY_PORT=8081
#TILESERVER_PORT=8080

# Port the second TileserverGL container (EPSG:4087) publishes on the host
# -- only present in the docker-compose.4087.yaml stack (see
# docs/deployment-4087.md).
#TILESERVER_4087_PORT=8083

# Compose files that plain `docker compose ...` commands use instead of the
# default docker-compose.yaml + docker-compose.override.yaml -- e.g. this
# makes `docker compose up -d`/`ps`/`logs` run the EPSG:4087 stack with
# nginx. Separate the files with ":" (";" on Windows). deploy.sh/deploy.ps1
# always pass their own -f list (see --4087/-Use4087), which overrides it.
#COMPOSE_FILE=docker-compose.yaml:docker-compose.4087.yaml:docker-compose.override.yaml

# uWSGI worker tuning for the mapproxy service (see mapproxy/config/uwsgi.ini).
# UWSGI_CHEAPER is how many workers keep running while idle -- more start
# under load, up to UWSGI_PROCESSES. It must be lower than UWSGI_PROCESSES
# (MapProxy won't start otherwise), so lower both together; 0 keeps every
# worker running.
#UWSGI_PROCESSES=8
#UWSGI_THREADS=4
#UWSGI_CHEAPER=4

# Shared-memory size for each container (increase if a service reports
# running out of shared memory under load).
#NGINX_SHM_SIZE=1gb
#MAPPROXY_SHM_SIZE=2gb
#TILESERVER_SHM_SIZE=2gb
