# Custom MapProxy image: Python 3.14 + conda-forge GDAL/PROJ >= 9.8
# (ellipsoidal EPSG:4087) + MapProxy 8 + uwsgi. Drop-in replacement for
# ghcr.io/mapproxy/mapproxy/mapproxy:8.1.0-nginx as this stack uses it
# (uwsgi directly; the official image's bundled nginx is not installed).
#
# Build from the repo root:
#   docker build -f Dockerfile.mapproxy -t rbt-mapproxy:8.1.0 .
#
# Reproducible: the conda packages come from mapproxy/conda-linux-64.lock and
# mapproxy/conda-linux-aarch64.lock -- exact package URLs with checksums --
# not from a fresh solve of mapproxy/environment.yml, so a build next month
# installs the same libraries as one today and a conda-forge release can't
# change what a merge publishes. After editing environment.yml, regenerate
# the lock files with scripts/lock-mapproxy.sh. MapProxy itself is pinned by
# MAPPROXY_VERSION below.

FROM mambaorg/micromamba:2.10.0-debian12-slim

ARG NEW_MAMBA_USER=mapproxy
ARG NEW_MAMBA_USER_ID=1000
ARG NEW_MAMBA_USER_GID=1000

USER root

# debian12-slim includes passwd (usermod/groupmod). Remap the image user
# to 1000:1000 so host bind-mounts (mapproxy/data, locks, tile_locks)
# match the existing deploy.sh / install-docs chown.
RUN usermod "--login=${NEW_MAMBA_USER}" "--home=/home/${NEW_MAMBA_USER}" \
      --move-home "-u ${NEW_MAMBA_USER_ID}" "${MAMBA_USER}" && \
    groupmod "--new-name=${NEW_MAMBA_USER}" \
      "-g ${NEW_MAMBA_USER_GID}" "${MAMBA_USER}" && \
    echo "${NEW_MAMBA_USER}" > /etc/arg_mamba_user && \
    chown -R "${NEW_MAMBA_USER_ID}:${NEW_MAMBA_USER_GID}" \
      "${MAMBA_ROOT_PREFIX}" "/home/${NEW_MAMBA_USER}"

ENV MAMBA_USER=$NEW_MAMBA_USER
# PATH so Kubernetes `command:` (which replaces Docker ENTRYPOINT) still
# finds uwsgi. PROJ_DATA/GDAL_DATA so those tools work without conda
# activation (same reason).
ENV PATH="${MAMBA_ROOT_PREFIX}/bin:${PATH}" \
    PROJ_DATA="${MAMBA_ROOT_PREFIX}/share/proj" \
    GDAL_DATA="${MAMBA_ROOT_PREFIX}/share/gdal" \
    PROJ_NETWORK=OFF

USER $MAMBA_USER

# One lock file per CPU architecture: conda packages are built per platform,
# and the image is published for both linux/amd64 and linux/arm64. The lock
# file is an explicit one (every package URL, with its checksum), which
# micromamba installs without solving, so nothing is resolved at build time.
COPY --chown=$MAMBA_USER:$MAMBA_USER \
     mapproxy/conda-linux-64.lock mapproxy/conda-linux-aarch64.lock /tmp/
RUN case "$(uname -m)" in \
      x86_64)  platform=linux-64 ;; \
      aarch64) platform=linux-aarch64 ;; \
      *) echo "no conda lock file for $(uname -m)" >&2; exit 1 ;; \
    esac && \
    micromamba install -y -n base -f "/tmp/conda-${platform}.lock" && \
    micromamba clean --all --yes && \
    rm /tmp/conda-linux-64.lock /tmp/conda-linux-aarch64.lock

ARG MAMBA_DOCKERFILE_ACTIVATE=1
ARG MAPPROXY_VERSION=8.1.0
# --no-deps: MapProxy is not on conda-forge; its PyPI deps include pyproj,
# whose wheels bundle a private PROJ and would undo the >=9.8 pin above.
# So pip never installs MapProxy's requirements: `pip check` fails the build
# if the lock files stop providing one, and the base-config load below
# proves MapProxy imports and builds its WSGI app against these libraries.
RUN pip install --no-cache-dir --no-deps "MapProxy==${MAPPROXY_VERSION}" && \
    pip check && \
    python -c "\
import pyproj; \
print('PROJ', pyproj.__proj_version__); \
assert tuple(int(p) for p in pyproj.__proj_version__.split('.')[:2]) >= (9, 8), pyproj.__proj_version__; \
from pyproj import Transformer; \
_, y = Transformer.from_crs(4326, 4087, always_xy=True).transform(10, 5); \
print('EPSG:4087 Y(10,5) =', y); \
assert abs(y - 552885.45) < 1, y" && \
    mapproxy-util create -t base-config /tmp/mapproxy-smoke && \
    python -c "\
from mapproxy.wsgiapp import make_wsgi_app; \
make_wsgi_app('/tmp/mapproxy-smoke/mapproxy.yaml')" && \
    rm -rf /tmp/mapproxy-smoke

WORKDIR /mapproxy
COPY --chown=$MAMBA_USER:$MAMBA_USER mapproxy/docker/app.py mapproxy/docker/mesh_guard.py /mapproxy/
# mesh_guard.py keeps non-finite coordinates out of Pillow's mesh transform,
# which segfaults a worker on linux/amd64 (the reason is in its header). Run
# its self-test here so a lock-file update that changes the behaviour fails
# the build instead of the first EPSG:4326 request. The
# segfault only happens on x86-64, so the amd64 build is the one that proves
# it.
RUN python /mapproxy/mesh_guard.py

# Numeric USER -- OpenShift validates this; Compose/Helm already run as 1000.
USER 1000

# Defaults for uwsgi.ini's $(UWSGI_*) settings, so the image also runs on its
# own. docker-compose.yaml and the Helm chart set their own values.
ENV UWSGI_PROCESSES=8 \
    UWSGI_THREADS=4 \
    UWSGI_CHEAPER=4

# micromamba ENTRYPOINT activates the env for Compose `command:`.
CMD ["uwsgi", "--ini", "/mapproxy/config/uwsgi.ini"]
